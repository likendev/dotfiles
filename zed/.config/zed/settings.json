// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "terminal": {
    "dock": "bottom",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent_servers": {
    "antigravity-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "fast": false
      },
      "type": "registry"
    },
  },
  "edit_predictions": {
    "provider": "zed",
    "ollama": {
      "api_url": "http://localhost:11434",
    },
  },
  "language_models": {
    "openai_compatible": {
      "Qwen3-Coder-30B-A3B-Instruct-MLX-4bit": {
        "api_url": "http://127.0.0.1:8000/v1",
        "available_models": [
          {
            "name": "Qwen3-Coder-30B-A3B-Instruct-MLX-4bit",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
            },
          },
        ],
      },
    },
    "lmstudio": {
      "api_url": "http://localhost:1234/api/v0",
    },
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
        },
        "delete_path": {
          "always_allow": [
            {
              "pattern": "^ai-playground/personal-website/src/",
            },
          ],
        },
        "create_directory": {
          "always_allow": [
            {
              "pattern": "^/Users/liken/workspace/ai-playground/",
            },
            {
              "pattern": "^ai-playground/personal-website/src/",
            },
          ],
        },
      },
    },
    "default_model": {
      "effort": "medium",
      "provider": "google",
      "model": "gemini-3.7-flash",
      "enable_thinking": true,
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "base_keymap": "VSCode",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "buffer_font_features": {
    "calt": false,
  },
  "ui_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "hard_tabs": false,
  "tab_size": 4
}
